{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chaos-monitor",
  // nitro builds the TanStack Start app to .output/server; worker.mjs adds the cron.
  "main": ".output/server/worker.mjs",
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },

  "assets": { "directory": ".output/public", "binding": "ASSETS" },

  // One engine tick per minute (replaces Lovable's pg_cron "chaos-rolling-scan").
  "triggers": { "crons": ["* * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chaos-monitor",
      "database_id": "5c8a45aa-a621-4345-8abb-f1a3ef75d6e4",
      "migrations_dir": "migrations"
    }
  ],

  // Fan-out: each unit of work runs in its own invocation with a fresh free-plan budget.
  "services": [{ "binding": "SELF", "service": "chaos-monitor" }],

  "vars": {
    "WRITE_BUDGET": "90000"
  }
}
